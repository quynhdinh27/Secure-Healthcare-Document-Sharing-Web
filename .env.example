# true  = chạy bằng mock data (không cần backend) — dùng để xem UI
# false = gọi backend Express thật qua proxy
VITE_USE_MOCK=true

# Prefix API nghiệp vụ
VITE_API_BASE=/api/v1

# Tên header CSRF (cần chốt với nhóm Auth)
VITE_CSRF_HEADER=X-CSRF-Token

# Địa chỉ backend cho dev proxy (chỉ dùng trong vite.config.js)
API_TARGET=http://localhost:3000
